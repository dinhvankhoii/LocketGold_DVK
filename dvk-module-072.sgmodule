#!name=DinhKhoi Media | dvk-module-072
#!desc=DinhKhoi Media - ban tuy chinh, giu nguyen ghi nhan tac gia goc
# 💬 phở bò (facebook): https://www.facebook.com/ViezHuwg/
# 🚀 Rewrite by: việt locket gold

[General]
user-agent = Locket/1.0.0 (iPhone; iOS 26.3; Scale/3.00)

[Script]
# ~ Locket Gold - Shadowrocket / Surge / LanceX

# RevenueCat Response
revenuecat = type=http-response, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/[^/]+$), script-path=https://raw.githubusercontent.com/andanh447/locketgold_tool/refs/heads/main/revenuecatviethung.js, requires-body=true, max-size=-1, timeout=60

# RevenueCat Request Header
deleteHeader = type=http-request, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers), script-path=https://raw.githubusercontent.com/dinhvankhoii/LocketGold_DVK/main/dvk-script-020.js, timeout=60

# Locket Firebase Remote Config
locket_rc = type=http-response, pattern=^https:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-4252a\/.+, script-path=https://raw.githubusercontent.com/dinhvankhoii/LocketGold_DVK/main/dvk-script-116.js, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND%, api.revenuecat.com, firebaseremoteconfig.googleapis.com
