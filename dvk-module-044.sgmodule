#!name=DinhKhoi Media | dvk-module-044
#!desc=DinhKhoi Media - Phiên bản tùy chỉnh
# 💬 Tiktok: https://www.tiktok.com/@dvk.frv
# 🚀 Rewrite by: bảo ngọc Server

[General]
user-agent = Locket/1.0.0 (iPhone; iOS 26.3; Scale/3.00)


[Rule]
DOMAIN,gdmf.apple.com,REJECT
DOMAIN,crl.apple.com,REJECT
DOMAIN,appledid.apple.com,REJECT
DOMAIN,certs.apple.com,REJECT
DOMAIN,valid.apple.com,REJECT
DOMAIN,ppq.apple.com,REJECT
DOMAIN,ocsp2.apple.com,REJECT
DOMAIN,ocsp.apple.com,REJECT

[Script]
# ~ Locket Gold - Shadowrocket / Surge / LanceX

# RevenueCat Response
revenuecat = type=http-response, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/[^/]+$), script-path=https://raw.githubusercontent.com/dinhvankhoii/LocketGold_DVK/main/dvk-script-086.js, requires-body=true, max-size=-1, timeout=60

# RevenueCat Request Header
deleteHeader = type=http-request, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers), script-path=https://raw.githubusercontent.com/dinhvankhoii/LocketGold_DVK/main/dvk-script-020.js, timeout=60

# Locket Firebase Remote Config
locket_rc = type=http-response, pattern=^https:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-4252a\/.+, script-path=https://raw.githubusercontent.com/dinhvankhoii/LocketGold_DVK/main/dvk-script-013.js, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND%, api.revenuecat.com, firebaseremoteconfig.googleapis.com
